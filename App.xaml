<Application
    x:Class="AiMeter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- [Part 249] 라디오·토글이 Windows 강조색(이 PC 는 분홍)을 따르던 것을 PC Up Check 하늘색으로 고정.
                 다크 테마의 강조 채움은 Light2(#38BDF8 = 브랜드 Primary)를 쓴다. -->
            <Color x:Key="SystemAccentColor">#0284C7</Color>
            <Color x:Key="SystemAccentColorLight1">#0EA5E9</Color>
            <Color x:Key="SystemAccentColorLight2">#38BDF8</Color>
            <Color x:Key="SystemAccentColorLight3">#7DD3FC</Color>
            <Color x:Key="SystemAccentColorDark1">#0369A1</Color>
            <Color x:Key="SystemAccentColorDark2">#075985</Color>
            <Color x:Key="SystemAccentColorDark3">#0C4A6E</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>

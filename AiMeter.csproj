<Project Sdk="Microsoft.NET.Sdk">

  <!-- [Part 246] AiMeter — AI 코딩 도구 사용 한도 트레이 앱.
       self-contained(런타임 설치 불필요). 산출물이 25MB 를 넘으므로
       pcupcheck.com(Cloudflare Pages) 이 아니라 GitHub Releases 로 배포한다(사용자 결정, OPEN_ISSUES OI-2 와 같은 제약).
       [Part 287] WinUI 3 → Avalonia 12 — 같은 화면을 맥에서도 그리기 위해(사용자 결정). 1a 는 Windows 만(동작 동일),
       맥 TFM 은 1b 에서 추가한다. 작업 표시줄 스트립은 Win32·GDI+ 그대로라 System.Drawing.Common 을 쓴다.
       WindowsAppSDK·H.NotifyIcon 과 .pri 복사(Part 250)는 WinUI 전용이라 뺐다. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AiMeter</RootNamespace>
    <AssemblyName>AiMeter</AssemblyName>
    <Product>AiMeter</Product>
    <Company>PC Up Check</Company>
    <Version>0.2.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SelfContained>true</SelfContained>
    <!-- [Part 287] Skia 네이티브 .pdb 가 100MB — 배포물에 넣지 않는다 -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <!-- [Part 287] Skia·HarfBuzz 네이티브 .pdb(합 100MB)는 NuGet 네이티브 파일로 따라와 DebugType=none 으로는 안 빠진다(실측) → publish 뒤에 지운다 -->
  <Target Name="RemoveNativePdbFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedPdb)" />
  </Target>

</Project>

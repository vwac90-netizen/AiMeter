<Project Sdk="Microsoft.NET.Sdk">

  <!-- [Part 246] AiMeter — AI 코딩 도구 사용 한도 트레이 앱.
       WinUI 3 unpackaged + self-contained(런타임 설치 불필요). 산출물이 25MB 를 넘으므로
       pcupcheck.com(Cloudflare Pages) 이 아니라 GitHub Releases 로 배포한다(사용자 결정, OPEN_ISSUES OI-2 와 같은 제약). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AiMeter</RootNamespace>
    <AssemblyName>AiMeter</AssemblyName>
    <Product>AiMeter</Product>
    <Company>PC Up Check</Company>
    <Version>0.1.9</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <!-- [Part 250] unpackaged WinUI 의 dotnet publish 는 앱 리소스 색인(AiMeter.pri)을 빠뜨린다 → 없으면 XamlControlsResources 를
       못 불러 시작하자마자 죽는다. 빌드 출력에서 publish 폴더로 복사한다. -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish" Condition="Exists('$(OutDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
